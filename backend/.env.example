# ── Reddit ────────────────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=sports-picks-aggregator/1.0

# Comma-separated subreddit names (no r/)
REDDIT_SUBREDDITS=sportsbetting,sportsbook

# Optional: only show posts from these specific users (comma-separated)
REDDIT_USERS=

# ── Twitter / X ───────────────────────────────────────────────────────────────
# Requires at least the Basic paid tier ($100/mo) from https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Comma-separated usernames to track (no @)
TWITTER_USERNAMES=user1,user2

# ── Discord ───────────────────────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable "Message Content Intent" under Bot settings
DISCORD_BOT_TOKEN=your_discord_bot_token

# Comma-separated channel IDs (right-click channel → Copy ID in developer mode)
DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
